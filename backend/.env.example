DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# このバックエンドの公開URL(管理サイトのログインに使う)。末尾スラッシュなし
PUBLIC_URL=http://localhost:8787
# CurseForge のパックを使う場合のみ(https://console.curseforge.com/ で取得)。空欄なら無効
CURSEFORGE_API_KEY=
PORT=8787
# ランチャーのOAuthリダイレクト(カンマ区切り)
ALLOWED_REDIRECTS=http://127.0.0.1:53682/callback
# リバースプロキシ配下なら 1
TRUST_PROXY=0
# 開発者専用ページ(/admin/dev)を見られる人の Discord ユーザーID(数字)。カンマ区切りで複数可。空欄なら誰も見られない
DEVELOPER_DISCORD_IDS=
# 任意: Google アナリティクス(GA4)の測定ID(G-XXXXXXXXXX)。設定すると紹介サイトにだけ、同意した訪問者向けに入る
GA_MEASUREMENT_ID=
